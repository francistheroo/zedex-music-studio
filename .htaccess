Options -Indexes
<FilesMatch "^(\.env|\.htaccess)$">
    Require all denied
</FilesMatch>
<Directory "config">
    Require all denied
</Directory>
<Directory "database">
    Require all denied
</Directory>
<Directory "includes">
    Require all denied
</Directory>
<Directory "scripts">
    Require all denied
</Directory>
